{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nustanakritwithai.github.io/Thai-economic-/schemas/source.schema.json",
  "title": "Economic Data Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id","name","owner","official_url","access_method","priority"],
  "properties": {
    "source_id": {"type":"string","pattern":"^[A-Z][A-Z0-9_]{1,31}$"},
    "name": {"type":"string","minLength":1},
    "owner": {"type":"string","minLength":1},
    "official_url": {"type":"string","format":"uri"},
    "access_method": {"type":"string","enum":["API","CSV","XLS","XLSX","JSON","HTML","FILE","MIXED"]},
    "priority": {"type":"string","enum":["P0","P1","P2"]},
    "expected_frequency": {"type":["string","null"]},
    "expected_release_lag": {"type":["string","null"]},
    "revision_possible": {"type":["boolean","null"]},
    "license": {"type":["string","null"]},
    "last_verified": {"type":["string","null"],"format":"date"}
  }
}
